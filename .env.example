# Backblaze B2 (required)
B2_REGION=your_b2_region
B2_APPLICATION_KEY_ID=your_application_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name

# Backblaze B2 (optional)
B2_PUBLIC_URL_BASE=

# Example of what filled-in values look like (fake — for visual reference only):
# B2_REGION=us-west-004
# B2_APPLICATION_KEY_ID=YOUR_APPLICATION_KEY_ID_HERE
# B2_APPLICATION_KEY=YOUR_APPLICATION_KEY_HERE
# B2_BUCKET_NAME=my-app-uploads
# B2_PUBLIC_URL_BASE=https://example.cdn/my-bucket

# The S3 endpoint is derived from B2_REGION as
# https://s3.<B2_REGION>.backblazeb2.com.

# Transcription — AssemblyAI (required, diarized).
ASSEMBLYAI_API_KEY=

# LLM for summary + action-item extraction — OpenAI by default.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# To use Anthropic Claude instead, uncomment the three lines below.
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
